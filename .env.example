# =====================================================================
# AI 数据自动化转换 Demo - 环境变量模板
# 复制为 .env 后按需修改（docker-compose 注入的环境变量优先于本文件）
# =====================================================================

# ---------- IRIS 连接（Docker 环境变量优先；本地开发默认值） ----------
IRIS_HOST=127.0.0.1
IRIS_PORT=1972
IRIS_NAMESPACE=USER
IRIS_USERNAME=superuser
IRIS_PASSWORD=SYS

# ---------- FHIR 数据源（IRIS 自带 FHIR Server） ----------
# 注意（方案 A）：FHIR 资源读写需要 Basic Auth，仅 /metadata 匿名公开
FHIR_BASE_URL=http://127.0.0.1:52773/csp/healthshare/fhirserver/fhir/r4/
FHIR_USERNAME=superuser
FHIR_PASSWORD=SYS

# ---------- LLM（OpenAI 兼容接口，AI 推荐功能必填） ----------
# 可填写 DeepSeek / 通义千问 / 智谱 / Kimi 等任意 OpenAI 兼容服务的 base_url
# 例如 DeepSeek: https://api.deepseek.com/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=gpt-4o-mini
